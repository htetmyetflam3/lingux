# Local tooling only. Pipeline outputs under content/ are core repository
# data and must stay tracked — do not ignore them.

# Python
__pycache__/
*.py[cod]
*.venv/
venv/
.venv/

# Node
node_modules/

# Editors / OS
*.swp
*.tmp
.DS_Store
Thumbs.db

# Logs
*.log

# Local environment (never commit secrets)
.env

# Build leftovers
dist/
coverage/

# Dictionaries: generated by format/fetch_dicts.py, ~25 MB, rebuild with --force
Engine/knowledge/dicts/

# Local MCP client configs (may contain API keys; keep them untracked)
.mcp.json
kilo.json
kilo.jsonc
.kilo/

# Comparison-data cache written by mt/mt_compare.py (rebuildable, 300 KB+)
content/mtranslate/comparison/
