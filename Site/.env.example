# Copy to .env and fill in. .env is git-ignored.
# Boot only strictly requires the two secrets below; everything else has a
# code default. Secrets must be >= 32 chars and must differ.

NODE_ENV=development
MODE=preproduction
HOST=0.0.0.0
PORT=3000

# SQLite (relative to Site/ unless absolute)
DB_FILE=.data/site.db

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-at-least-32-random-hex-chars-0000
SESSION_SECRET=replace-with-a-different-32-random-hex-chars-1111

# Empty TRUST_PROXY = use the socket address. Set it behind a reverse proxy.
TRUST_PROXY=
# Empty EDGE_SECRET disables the edge-origin guard (direct-host preproduction).
EDGE_SECRET=
# COOKIE_SECURE=false is correct for a plain-HTTP local run; set true on HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Engine round (leave blank to run with the engine not-wired)
ENGINE_JOB_URL=
SITE_TO_ENGINE_KEY=
ENGINE_TO_SITE_KEY=
ENGINE_ACCEPT_TIMEOUT_MS=
ENGINE_JOB_TIMEOUT_MS=

# Off-path curl endpoint (unset both to disable)
CURL_ENDPOINT=
CURL_KEY=

# Limits (defaults shown; all optional)
ARTIFACT_TTL_HOURS=24
UPLOAD_MAX_MB=64
UPLOAD_RATE_MAX=20
PARSER_MAX_CONCURRENCY=2
DAILY_UPLOAD_LIMIT=0
