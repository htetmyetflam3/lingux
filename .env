# ── Dev bypasses ──
DEV_BYPASS_IP=103.84.100.46
DEV_BYPASS_IP=::1
DEV_BYPASS_HEADER=true
DEV_BYPASS_QUOTA=true

# ── Limits ──
# Daily submissions per anonymous visitor. Anti-spam, not a billing plan.
FREE_DAILY_QUOTA=3

# TEMPORARY, dev only: opens the cookie+session gate and allows bot-shaped
# User-Agents so curl can exercise /api/submit. Hard-ignored whenever
# NODE_ENV=production (see Server/cookie/devbypass.js) — it cannot ship.
DEV_BYPASS_SESSION=true

# ── Engine (Private) ──
# Private/monoSyllabism/api-server.js — the Site pushes parsed file text here
# (POST /process, text in the body, hash = submitId). ENGINE_KEY falls back
# to FSM_KEY when unset. Set API_KEY on the engine to require it.
ENGINE_ENDPOINT=http://localhost:9000
ENGINE_TIMEOUT_MS=300000

# ── Engine handshake allowlists (dev placeholders) ──
# The engine refuses /metadata + /process unless X-API-Key matches FSM_KEY
# (above), the caller IP is allow-listed (loopback always + every
# DEV_BYPASS_IP entry; override with ENGINE_ALLOWED_IPS) and any
# Origin/Referer it sends resolves to a host listed here. Production:
# replace with the real frontend origin + server IP.
ENGINE_ALLOWED_ORIGINS=localhost:3000,localhost,127.0.0.1:3000

# praser machine-boundary key: callers arriving from OUTSIDE the machine
# (port forwards/proxies) must send X-Praser-Key. Loopback never needs it.
PRASER_KEY=1f2ef6bfa739eced6e0c0ac53d391d6a
